# ---------------------------------------------------------------------------
# CheckMyPaper environment. Copy to .env.local and fill what you have.
# The app runs WITHOUT any of these (mock extraction + typed transcripts),
# so you can demo the full loop first, then switch on real AI.
# ---------------------------------------------------------------------------

# Claude — powers paper extraction (vision), per-question diagnosis, and the
# paper insight summary. Without it, a sample paper + your self-tags are used.
ANTHROPIC_API_KEY=

# Voice transcription via any OpenAI-compatible Whisper endpoint (OpenAI, Groq…).
# Without it, students type their approach instead of speaking.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1   # or https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-1                        # or whisper-large-v3 (Groq)

# ---- Cloud sync (LATER — v1 is local-first, these are not required yet) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
