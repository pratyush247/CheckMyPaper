# ---------------------------------------------------------------------------
# CheckMyPaper environment. Copy to .env.local and fill what you have.
# The app runs WITHOUT any of these (mock extraction + typed transcripts),
# so you can demo the full loop first, then switch on real AI.
# ---------------------------------------------------------------------------

# DeepSeek V4 Flash — structures OCR'd questions, per-question diagnosis, and the
# paper insight summary (text reasoning). Without it, a sample paper is used.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OCR — reads paper page images into text via an OpenAI-compatible vision model.
# NOTE: OpenRouter does NOT host deepseek/deepseek-ocr, so on OpenRouter use a
# multimodal model (google/gemini-2.5-flash works great). For the real
# deepseek-ocr model, point this at Novita/DeepInfra instead.
# Without it, a sample paper is used instead of real scanning.
DEEPSEEK_OCR_API_KEY=
# DEEPSEEK_OCR_BASE_URL=https://openrouter.ai/api/v1   # or https://api.novita.ai/openai
# DEEPSEEK_OCR_MODEL=google/gemini-2.5-flash           # deepseek/deepseek-ocr on Novita/DeepInfra
# APP_URL=https://checkmypaper.vercel.app              # OpenRouter attribution header

# Voice transcription — Sarvam AI (best for Hindi/English code-mixed JEE speech).
# Without any transcription key, students type their approach instead.
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saarika:v2.5     # or saaras:v3
# SARVAM_LANGUAGE=unknown           # auto-detect; or e.g. hi-IN, en-IN

# Fallback: any OpenAI-compatible Whisper endpoint (used only if no SARVAM_API_KEY).
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=whisper-1

# Voice answers (text-to-speech) reuse SARVAM_API_KEY (Bulbul). Optional tuning:
# SARVAM_TTS_LANGUAGE=en-IN     # or hi-IN
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_TTS_MODEL=bulbul:v3

# Visuals — a separate CHEAP model good at SVG, for doubt answers + battle lessons.
# Defaults to the OpenRouter key above; set a cheap visual model of your choice.
VISUAL_API_KEY=
# VISUAL_BASE_URL=https://openrouter.ai/api/v1
# VISUAL_MODEL=google/gemini-2.5-flash-lite   # cheaper; use gemini-2.5-flash for crisper diagrams

# ---- Multiplayer (Battle leaderboards + friend squads) ----
# Server-only. All DB access is via our API using the service role key; the
# browser never talks to Supabase directly. Without these, leaderboards fall
# back to local/simulated rivals. Run supabase/migrations/0002_multiplayer.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
